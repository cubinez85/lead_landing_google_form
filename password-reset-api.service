[Unit]
Description=Password Reset API (Gunicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=notify
User=cubinez85
Group=cubinez85
WorkingDirectory=/home/cubinez85/lead_landing_google_form/landing
Environment="PATH=/home/cubinez85/lead_landing_google_form/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/cubinez85/lead_landing_google_form/venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:8087 \
    --timeout 120 \
    --access-logfile /var/log/leads-automation/gunicorn-access.log \
    --error-logfile /var/log/leads-automation/gunicorn-error.log \
    wsgi:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
